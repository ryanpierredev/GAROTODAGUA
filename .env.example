# PostgreSQL local da EC2. Preencha a senha somente no arquivo privado .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=garotodagua
PGUSER=garotodagua
PGPASSWORD=
SITE_URL=http://3.142.79.208:8080

# Credenciais da API oficial do WhatsApp Cloud (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# Alertas do administrador: preencher somente no .env privado da EC2.
# Número completo com país/DDD, só dígitos. Modelo aprovado com 2 parâmetros:
# {{1}} título do aviso; {{2}} detalhes.
WHATSAPP_ADMIN_PHONE=
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_ALERT_LANGUAGE=pt_BR

# Telegram: obtenha o token no @BotFather e guarde apenas no .env privado.
# npm run telegram:setup vincula sua conversa e preenche TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
